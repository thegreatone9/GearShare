# ============================================================
# GearShare Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored and will NOT be committed.
# ============================================================

# --- Frontend (Vite) ---
# These must be prefixed with VITE_ to be available in the browser.
VITE_SUPABASE_PROJECT_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_API_KEY=your-supabase-anon-key

# --- Backend (Server Handlers) ---
# PostgreSQL connection string for Supabase (used by server/util/transaction.js)
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-password@your-host:6543/postgres

# --- Local Development (Optional) ---
# Set these to 'true' to use the in-memory SQLite dev server instead of Supabase.
# When using `npm run dev:local`, these are set automatically.
# VITE_USE_LOCAL_DB=true
# USE_LOCAL_DB=true

# --- Debug (Optional) ---
# Enable verbose SQL logging in the SQLite adapter
# DEBUG_SQL=true
